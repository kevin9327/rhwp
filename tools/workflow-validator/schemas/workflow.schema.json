{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Workflow Schema",
  "description": "Schema for agent workflow validation",
  "type": "object",
  "required": ["name", "version", "steps"],
  "properties": {
    "name": {"type": "string"},
    "version": {"type": "string"},
    "description": {"type": "string"},
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "command"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "command": {"type": "string"},
          "validations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": {
                  "enum": ["exit_code", "json_valid", "file_exists"]
                }
              }
            }
          }
        }
      }
    }
  }
}
